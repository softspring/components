{% trans_default_domain 'sfs_components' %}
{% set body_classes = (body_classes|default('') ~ ' sfs-admin-layout ' ~ (sfs_admin_lock_body_scroll|default(true) ? 'overflow-hidden ' : '') ~ 'bg-body-tertiary')|trim %}
{% extends 'base.html.twig' %}

{% block stylesheets %}
    {# OVERRIDE THIS BLOCK AND INCLUDE ENCORE TAGS TO USE YOUR CUSTOM STYLES #}
    {#{{ encore_entry_link_tags('admin') }}#}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.3.0/font/bootstrap-icons.css">
{% endblock %}

{% block header_javascripts %}
    {# OVERRIDE THIS BLOCK AND INCLUDE ENCORE TAGS TO USE YOUR CUSTOM JS #}
    {#{{ encore_entry_script_tags('admin') }}#}
{% endblock %}

{% block javascripts %}
    {# OVERRIDE THIS BLOCK AND INCLUDE ENCORE TAGS TO USE YOUR CUSTOM JS #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
{% endblock %}

{% block body %}
    <div class="sfs-admin-shell d-flex vh-100 overflow-hidden">
        <aside id="sfs-admin-sidebar" class="sfs-admin-sidebar offcanvas-lg offcanvas-start border-end flex-shrink-0 h-100" tabindex="-1" aria-labelledby="sfs-admin-sidebar-title">
            <div class="offcanvas-header d-lg-none border-bottom px-3 py-3">
                <a href="{{ block('admin_home_url')|trim }}" class="d-inline-flex align-items-center text-decoration-none text-body">
                    {{ block('logo_img') }}
                </a>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="{{ 'layout.sidebar.close'|trans }}"></button>
            </div>
            <div class="offcanvas-body d-flex h-100 flex-column p-0 min-vh-0">
                <div class="sfs-admin-sidebar-top d-none d-lg-flex align-items-center justify-content-between gap-3 border-bottom px-3 px-xl-4 py-3">
                    <a href="{{ block('admin_home_url')|trim }}" class="sfs-admin-sidebar-brand d-inline-flex align-items-center gap-2 text-decoration-none text-body">
                        <span class="sfs-admin-sidebar-brand-expanded">{% block logo_img %}<img src="https://dummyimage.com/100x35/ffffff/{{ app_color|default('4f46e5') }}.png?text=LOGO" height="35" alt="logo"/>{% endblock %}</span>
                        <span class="sfs-admin-sidebar-brand-collapsed">{% block logo_mark %}{{ block('logo_img') }}{% endblock %}</span>
                    </a>
                    <button type="button" class="sfs-admin-sidebar-desktop-toggle btn btn-sm btn-outline-secondary border-0 rounded-circle d-inline-flex align-items-center justify-content-center" data-sfs-admin-sidebar-toggle="desktop" aria-label="{{ 'layout.sidebar.toggle'|trans }}">
                        <span class="bi bi-chevron-double-left"></span>
                    </button>
                </div>
                {% block sidebar %}
                    <div class="sfs-admin-sidebar-scroll flex-grow-1 overflow-auto overflow-x-hidden p-3 p-xl-4" id="main-menu-wrapper">
                        {% include admin_menu._view|default('@SfsComponents/sidebar/sidebar-pills.html.twig') with {'menu': admin_menu} %}
                    </div>
                {% endblock sidebar %}
            </div>
        </aside>

        <div class="sfs-admin-main d-flex h-100 flex-column flex-grow-1 overflow-auto overflow-x-hidden">
            {% block header %}
                <header class="sfs-admin-topbar flex-shrink-0">
                    <div class="container-fluid px-3 px-lg-4 py-3">
                        <div class="d-flex align-items-center justify-content-between gap-3">
                            <div class="d-flex min-w-0 align-items-center gap-2 gap-lg-3">
                                <button type="button" class="btn btn-light d-inline-flex d-lg-none align-items-center justify-content-center rounded-circle border shadow-sm" data-bs-toggle="offcanvas" data-bs-target="#sfs-admin-sidebar" aria-controls="sfs-admin-sidebar" aria-label="{{ 'layout.sidebar.open'|trans }}">
                                    <span class="bi bi-list"></span>
                                </button>

                                {% block breadcrumbs %}
                                    <div class="min-w-0">
                                        <nav aria-label="breadcrumb">
                                            <ol class="breadcrumb mb-0 small ps-0">
                                    {% block breadcrums_content %}
                                                <li class="breadcrumb-item"><a href="{{ block('admin_home_url')|trim }}">Admin</a></li>
                                    {% endblock breadcrums_content %}
                                            </ol>
                                        </nav>
                                    </div>
                                {% endblock breadcrumbs %}
                            </div>

                            <div class="d-flex flex-shrink-0 align-items-center gap-2">
                                {% block topbar_actions %}{% endblock topbar_actions %}

                                <div class="dropdown text-end">
                                    <a href="#" class="sfs-admin-user-trigger btn border rounded-circle p-0 d-inline-flex align-items-center justify-content-center overflow-hidden" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                                        {% block user_avatar %}
                                            {% if sfs_user_is('avatar') %}
                                                <img alt="{{ app.user.displayName }}" src="{{ app.user.avatarUrl }}" width="40" height="40" class="rounded-circle">
                                            {% else %}
                                                <span class="bi bi-person fs-5"></span>
                                            {% endif %}
                                        {% endblock %}
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end border-0 rounded-4 shadow-sm mt-2" aria-labelledby="dropdownUser1">
                                        {% if route_defined('sfs_user_preferences') %}
                                            <li><a class="dropdown-item" href="{{ url('sfs_user_preferences') }}"><span class="bi bi-person me-2"></span>{{ 'layout.user_menu.profile'|trans }}</a></li>
                                        {% endif %}
                                        {% if route_defined('sfs_user_change_password') %}
                                            <li><a class="dropdown-item" href="{{ url('sfs_user_change_password') }}"><span class="bi bi-key me-2"></span>{{ 'layout.user_menu.change_password'|trans }}</a></li>
                                        {% endif %}
                                        {% if route_defined('sfs_user_logout') %}
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item" href="{{ url('sfs_user_logout') }}"><span class="bi bi-box-arrow-right me-2"></span>{{ 'layout.user_menu.logout'|trans }}</a></li>
                                        {% endif %}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </header>
            {% endblock header %}

            <section id="main-content" class="sfs-admin-content flex-grow-1">
                <div class="container-fluid px-3 px-lg-4 pb-4 pb-lg-5">
                    {% block content %}
                    {% endblock content %}
                </div>
            </section>
        </div>
    </div>

    {% include '@SfsComponents/flash-messages/alerts.html.twig' %}
{% endblock body %}

{% block admin_home_url %}
    /admin
{% endblock admin_home_url %}
