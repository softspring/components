{
    "name": "softspring/components",
    "description": "This library provides some Symfony components like templates.",
    "type": "symfony-bundle",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "symfony/twig-bundle": "^6.4|^7.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.68",
        "phpstan/phpstan": "^1.9",
        "rector/rector": "^1.0"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Softspring\\Component\\Components\\": "src/"
        }
    }
}
